# ---------------------------------------------------------------------------
# InsightFlow environment configuration
# Copy this file to .env and replace placeholder values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL (Docker Compose default)
DATABASE_URL=postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow

# Lightweight local alternative (relative paths resolve against the repo root):
# DATABASE_URL=sqlite:///storage/insightflow.db

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=500000

# Storage (relative paths resolve against the repository root)
STORAGE_DIR=storage
# UPLOAD_DIR=storage/uploads
# PROCESSED_DIR=storage/processed

# LLM (any OpenAI-compatible chat completions API)
# Leave the key empty to run the assistant in calculations-only mode.
LLM_API_KEY=
# LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2

# Machine learning defaults
ANOMALY_CONTAMINATION=0.05
ANOMALY_RANDOM_STATE=42

# Frontend (used by Streamlit)
API_BASE_URL=http://localhost:8000
# Browser-facing API URL for download links (set to the public backend URL in Docker)
PUBLIC_API_BASE_URL=http://localhost:8000

# Optional host ports for Docker Compose (defaults: 8000 backend, 8501 frontend)
# BACKEND_PORT=8000
# FRONTEND_PORT=8501
